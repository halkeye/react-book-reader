{
  "name": "react-book-reader",
  "version": "0.1.0",
  "description": "Book Reader: ...",
  "author": "Gavin Mogan <gavin@gavinmogan.com> (http://www.halkeye.net)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@bitbucket.org:halkeye/react-book-reader.git"
  },
  "bugs": {
    "url": "https://bitbucket.org/halkeye/react-book-reader/issues",
    "email": "book-reader@gavinmogan.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "coverage": "jest --coverage",
    "test": "jest"
  },
  "jest": {
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga|css|scss)$": "<rootDir>/__tests__/__mocks__/fileMock.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/.eslintrc.js",
      "/__tests__/__mocks__/fileMock.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/__setup__.js",
      "/__tests__/.eslintrc.js",
      "/__tests__/__mocks__/fileMock.js"
    ],
    "setupTestFrameworkScriptFile": "./jestSetup.js"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@fontsource/roboto": "^5.0.13",
    "@mui/material": "^5.15.20",
    "@use-gesture/react": "^10.3.1",
    "br-mousetrap": "^1.1.3",
    "diacritics": "^1.3.0",
    "es6-promise": "^4.2.8",
    "file-loader": "^6.2.0",
    "howler": "^2.2.4",
    "immutable": "^4.3.6",
    "lodash": "^4.17.21",
    "media": "^0.2.1",
    "raw-loader": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shuffle": "^0.2.5",
    "uuid": "^10.0.0",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@types/diacritics": "^1.3.3",
    "@types/howler": "^2.2.11",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-no-only-tests": "^3.1.0",
    "eslint-plugin-promise": "^6.2.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "eslint-plugin-unicorn": "^54.0.0",
    "history": "^5.3.0",
    "jotai": "^2.8.3",
    "jotai-location": "^0.5.5",
    "p-event": "^6.0.1",
    "postcss-nesting": "^12.1.5",
    "prettier": "^3.3.2",
    "react-helmet-async": "^2.0.5",
    "sass": "^1.77.6",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
