{
  "name": "react-book-reader",
  "version": "0.1.0",
  "description": "Book Reader: ...",
  "author": "Gavin Mogan <gavin@gavinmogan.com> (http://www.halkeye.net)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@bitbucket.org:halkeye/react-book-reader.git"
  },
  "bugs": {
    "url": "https://bitbucket.org/halkeye/react-book-reader/issues",
    "email": "book-reader@gavinmogan.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "coverage": "jest --coverage",
    "test": "jest"
  },
  "jest": {
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga|css|scss)$": "<rootDir>/__tests__/__mocks__/fileMock.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/.eslintrc.js",
      "/__tests__/__mocks__/fileMock.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/__setup__.js",
      "/__tests__/.eslintrc.js",
      "/__tests__/__mocks__/fileMock.js"
    ],
    "setupTestFrameworkScriptFile": "./jestSetup.js"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/material": "^5.15.20",
    "@use-gesture/react": "^10.3.1",
    "br-mousetrap": "^1.1.3",
    "diacritics": "^1.3.0",
    "es6-promise": "^4.2.8",
    "file-loader": "^6.2.0",
    "howler": "^2.2.4",
    "immutable": "^4.3.6",
    "lodash": "^4.17.21",
    "media": "^0.2.1",
    "raw-loader": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shuffle": "^0.2.5",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^2.2.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "history": "^5.3.0",
    "react-redux": "^9.1.2",
    "react-router-redux": "^4.0.8",
    "redux-logger": "^3.0.6",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
