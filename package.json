{
  "name": "react-book-reader",
  "version": "0.1.0",
  "description": "Book Reader: ...",
  "author": "Gavin Mogan <gavin@gavinmogan.com> (http://www.halkeye.net)",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@bitbucket.org:halkeye/react-book-reader.git"
  },
  "bugs": {
    "url": "https://bitbucket.org/halkeye/react-book-reader/issues",
    "email": "book-reader@gavinmogan.com"
  },
  "devDependencies": {
    "autoprefixer-loader": "^3.2.0",
    "babel-core": "^6.26.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "enzyme": "^3.11.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jsx-loader": "^0.13.2",
    "node-libs-browser": "^2.2.1",
    "prettier-eslint": "^16.3.0",
    "prettier-eslint-cli": "^8.0.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "style-loader": "^4.0.0",
    "styled-jsx": "^5.1.6",
    "webpack": "^5.92.0",
    "webpack-dev-server": "^5.0.4"
  },
  "scripts": {
    "build:dev": "NODE_ENV=development webpack --env.prod=true",
    "build:prod": "NODE_ENV=production webpack --env.prod=true",
    "codacy": "cat ./coverage/lcov.info | codacy-coverage",
    "coverage": "jest --coverage",
    "dev": "webpack-dev-server --port=3000",
    "lint": "eslint --ignore-path .gitignore .",
    "test": "jest"
  },
  "jest": {
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga|css|scss)$": "<rootDir>/__tests__/__mocks__/fileMock.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/.eslintrc.js",
      "/__tests__/__mocks__/fileMock.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/__setup__.js",
      "/__tests__/.eslintrc.js",
      "/__tests__/__mocks__/fileMock.js"
    ],
    "setupTestFrameworkScriptFile": "./jestSetup.js"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/material": "^5.15.20",
    "@use-gesture/react": "^10.3.1",
    "br-mousetrap": "^1.1.3",
    "diacritics": "^1.3.0",
    "es6-promise": "^4.2.8",
    "file-loader": "^6.2.0",
    "history": "^5.3.0",
    "howler": "^2.2.4",
    "immutable": "^4.3.6",
    "lodash": "^4.17.21",
    "media": "^0.2.1",
    "object-assign": "^4.1.1",
    "raw-loader": "^4.0.2",
    "react-document-meta": "^2.1.2",
    "react-document-title": "^2.0.3",
    "react-immutable-proptypes": "^2.2.0",
    "react-router": "^6.23.1",
    "react-router-dom": "^6.23.1",
    "react-router-redux": "^5.0.0-alpha.9",
    "shuffle": "^0.2.5",
    "whatwg-fetch": "^3.6.20"
  }
}
